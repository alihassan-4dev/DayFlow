# Where the app finds the DayFlow backend.
#
# Local testing (phone + PC on the same Wi-Fi): your PC's LAN IP —
#   EXPO_PUBLIC_API_URL=http://192.168.1.9:8000
# Deployed backend (Vercel):
#   EXPO_PUBLIC_API_URL=https://day-flow-zeta.vercel.app
#
# Leave unset to auto-use the Expo dev server's host (usually right in dev).
#
# This file is only read by `expo start` on your machine. EAS builds never see
# it (.env is git-ignored), so the URL for a build lives in eas.json instead.
EXPO_PUBLIC_API_URL=
