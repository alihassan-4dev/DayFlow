{
  "expo": {
    "name": "DayFlow",
    "slug": "dayflow-frontend",
    "version": "1.1.0",
    "scheme": "dayflow",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "backgroundColor": "#15173A",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#15173A"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.alihassancodes.dayflow",
      "buildNumber": "2",
      "infoPlist": {
        "UIBackgroundModes": []
      }
    },
    "android": {
      "package": "com.alihassancodes.dayflow",
      "versionCode": 2,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundImage": "./assets/adaptive-icon-bg.png",
        "backgroundColor": "#15173A"
      },
      "edgeToEdgeEnabled": true,
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#5FB8F0",
          "defaultChannel": "task-reminders"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#15173A",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#15173A",
            "image": "./assets/splash-icon.png"
          }
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "DayFlow uses the microphone so you can talk to your assistant."
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-asset"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d7223723-82ff-4b07-8597-0ad69a7a361e"
      }
    },
    "owner": "alihassan_codes"
  }
}
