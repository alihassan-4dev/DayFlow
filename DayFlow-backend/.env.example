# --- Database -----------------------------------------------------------
# Neon: create a project at https://neon.tech, copy the connection string,
# and switch the driver to asyncpg:
#   DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@ep-xxx.aws.neon.tech/dayflow?ssl=require
# Leave unset to use a local SQLite file (fine for development).
DATABASE_URL=

# --- Auth ---------------------------------------------------------------
# Generate one: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-in-production

# --- AI -----------------------------------------------------------------
# Free key at https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Long-term memory runs LOCALLY by default (mem0 OSS: Groq + local embeddings
# + Chroma in ./mem0_db) as soon as GROQ_API_KEY is set — nothing to configure.
# Optionally set a key from https://app.mem0.ai to use the hosted platform instead.
MEM0_API_KEY=
LOCAL_MEMORY_ENABLED=false

APP_ENVIRONMENT=development
APP_DEBUG=true

# JSON list of browser origins. Native mobile requests are not restricted by CORS.
# In production, replace this with any web frontend domains you actually use.
CORS_ORIGINS=["*"]
