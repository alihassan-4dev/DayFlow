# --- Database -----------------------------------------------------------
# Neon: create a project at https://neon.tech, copy the connection string,
# and switch the driver to asyncpg:
#   DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@ep-xxx.aws.neon.tech/dayflow?ssl=require
# Leave unset to use a local SQLite file (fine for development).
DATABASE_URL=

# --- Auth ---------------------------------------------------------------
# Generate one: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-in-production

# --- AI -----------------------------------------------------------------
# Free key at https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Long-term memory runs LOCALLY by default (mem0 OSS: Groq + local embeddings
# + Chroma in ./mem0_db) as soon as GROQ_API_KEY is set — nothing to configure.
# Optionally set a key from https://app.mem0.ai to use the hosted platform instead.
MEM0_API_KEY=
LOCAL_MEMORY_ENABLED=false

# --- AI push notifications ---------------------------------------------
# Messages are generated live by Groq. No hard-coded reminder is sent.
PUSH_NOTIFICATIONS_ENABLED=false
# Optional: required only if Expo enhanced push security is enabled.
EXPO_PUSH_ACCESS_TOKEN=
# From the free Upstash QStash dashboard. QStash securely calls the worker
# endpoint once per minute, which works even when FastAPI Cloud scales to zero.
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
# Alternative for a scheduler that can send a private request header.
INTERNAL_SCHEDULER_SECRET=
NOTIFICATION_GRACE_MINUTES=30

APP_ENVIRONMENT=development
APP_DEBUG=true

# JSON list of browser origins. Native mobile requests are not restricted by CORS.
# In production, replace this with any web frontend domains you actually use.
CORS_ORIGINS=["*"]
